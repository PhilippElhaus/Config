# ==============================================================================
# Copy-paste ready script for creating install-dev-tools-macos.sh.
# Intended to be run on macOS.
# Public Domain; 2026 Philipp Elhaus
# ==============================================================================

cat > install-dev-tools-macos.sh <<'EOF'
#!/usr/bin/env bash

set +e

if [ -t 1 ]; then
	INFO_COLOR=$'\033[1;34m'
	RUN_COLOR=$'\033[1;36m'
	OK_COLOR=$'\033[1;32m'
	SKIP_COLOR=$'\033[1;90m'
	WARN_COLOR=$'\033[1;33m'
	SUMMARY_COLOR=$'\033[1;35m'
	RESET_COLOR=$'\033[0m'
else
	INFO_COLOR=""
	RUN_COLOR=""
	OK_COLOR=""
	SKIP_COLOR=""
	WARN_COLOR=""
	SUMMARY_COLOR=""
	RESET_COLOR=""
fi

success_count=0
skip_count=0
fail_count=0
skipped_items=()
failed_commands=()
log_file="${TMPDIR:-/tmp}/install-dev-tools-macos-$(date +%Y%m%d-%H%M%S).log"
verbose="${INSTALL_DEV_TOOLS_VERBOSE:-0}"

: > "$log_file"

timestamp() {
	date '+%Y-%m-%dT%H:%M:%S%z'
}

log() {
	printf "\n%s[INFO]%s %s\n" "$INFO_COLOR" "$RESET_COLOR" "$1"
}

warn() {
	printf "%s[WARN]%s %s\n" "$WARN_COLOR" "$RESET_COLOR" "$1"
	printf "\n[WARN] %s\n[TIME] %s\n" "$1" "$(timestamp)" >> "$log_file"
}

skip() {
	local label="$1"
	local detail="${2:-}"
	skip_count=$((skip_count + 1))
	skipped_items+=("$label")
	printf "%s[SKIP]%s %s\n" "$SKIP_COLOR" "$RESET_COLOR" "$label"
	{
		printf "\n[SKIP] %s\n" "$label"
		printf "[TIME] %s\n" "$(timestamp)"
		if [ -n "$detail" ]; then
			printf "[DETAIL] %s\n" "$detail"
		fi
	} >> "$log_file"
}

run() {
	local status
	printf "\n%s[RUN]%s %s\n" "$RUN_COLOR" "$RESET_COLOR" "$*"
	{
		printf "\n[RUN] %s\n" "$*"
		printf "[TIME] %s\n" "$(timestamp)"
	} >> "$log_file"
	if [ "$verbose" = "1" ]; then
		bash -c "$*" 2>&1 | tee -a "$log_file"
		status=${PIPESTATUS[0]}
	else
		bash -c "$*" >> "$log_file" 2>&1
		status=$?
	fi
	if [ "$status" -eq 0 ]; then
		success_count=$((success_count + 1))
		printf "%s[OK]%s %s\n" "$OK_COLOR" "$RESET_COLOR" "$*"
	else
		fail_count=$((fail_count + 1))
		failed_commands+=("$*")
		printf "%s[WARN]%s Failed with exit code %s, continuing: %s\n" "$WARN_COLOR" "$RESET_COLOR" "$status" "$*"
	fi
}

command_exists() {
	command -v "$1" >/dev/null 2>&1
}

setup_brew_path() {
	if command_exists brew; then
		return
	fi
	if [ -x /opt/homebrew/bin/brew ]; then
		eval "$(/opt/homebrew/bin/brew shellenv)"
	elif [ -x /usr/local/bin/brew ]; then
		eval "$(/usr/local/bin/brew shellenv)"
	fi
}

brew_formula_installed() {
	brew list --formula "$1" >/dev/null 2>&1
}

install_brew_packages() {
	local label="$1"
	local package
	local -a missing=()
	local -a installed=()
	shift
	for package in "$@"; do
		if brew_formula_installed "$package"; then
			installed+=("$package")
		else
			missing+=("$package")
		fi
	done
	if [ "${#installed[@]}" -gt 0 ]; then
		skip "$label Homebrew formulae already installed: ${#installed[@]}" "${installed[*]}"
	fi
	if [ "${#missing[@]}" -gt 0 ]; then
		run "brew install ${missing[*]}"
	fi
}

brew_cask_installed() {
	brew list --cask "$1" >/dev/null 2>&1
}

install_brew_casks() {
	local label="$1"
	local cask
	local -a missing=()
	local -a installed=()
	shift
	for cask in "$@"; do
		if brew_cask_installed "$cask"; then
			installed+=("$cask")
		else
			missing+=("$cask")
		fi
	done
	if [ "${#installed[@]}" -gt 0 ]; then
		skip "$label Homebrew casks already installed: ${#installed[@]}" "${installed[*]}"
	fi
	if [ "${#missing[@]}" -gt 0 ]; then
		run "brew install --cask ${missing[*]}"
	fi
}

npm_package_installed() {
	npm list -g --depth=0 "$1" >/dev/null 2>&1
}

install_npm_packages() {
	local package
	local -a missing=()
	local -a installed=()
	for package in "$@"; do
		if npm_package_installed "$package"; then
			installed+=("$package")
		else
			missing+=("$package")
		fi
	done
	if [ "${#installed[@]}" -gt 0 ]; then
		skip "Global npm packages already installed: ${#installed[@]}" "${installed[*]}"
	fi
	if [ "${#missing[@]}" -gt 0 ]; then
		run "npm install -g ${missing[*]}"
	fi
}

python_package_installed() {
	python3 -m pip show "$1" >/dev/null 2>&1
}

install_python_packages() {
	local package
	local pip_break=""
	local -a missing=()
	local -a installed=()
	for package in "$@"; do
		if python_package_installed "$package"; then
			installed+=("$package")
		else
			missing+=("$package")
		fi
	done
	if [ "${#installed[@]}" -gt 0 ]; then
		skip "Python packages already installed: ${#installed[@]}" "${installed[*]}"
	fi
	if [ "${#missing[@]}" -gt 0 ]; then
		if python3 -m pip install --help 2>/dev/null | grep -q -- "--break-system-packages"; then
			pip_break=" --break-system-packages"
		fi
		run "python3 -m pip install --user${pip_break} ${missing[*]}"
	fi
}

print_summary() {
	printf "\n%s[SUMMARY]%s %s succeeded, %s skipped/already done, %s failed\n" "$SUMMARY_COLOR" "$RESET_COLOR" "$success_count" "$skip_count" "$fail_count"
	if [ "$skip_count" -gt 0 ]; then
		printf "%s[SKIP]%s Skipped/already done:\n" "$SKIP_COLOR" "$RESET_COLOR"
		for item in "${skipped_items[@]}"; do
			printf "  - %s\n" "$item"
		done
	fi
	if [ "$fail_count" -gt 0 ]; then
		printf "%s[WARN]%s Failed commands:\n" "$WARN_COLOR" "$RESET_COLOR"
		for command in "${failed_commands[@]}"; do
			printf "  - %s\n" "$command"
		done
		printf "%s[INFO]%s Full install log: %s\n" "$INFO_COLOR" "$RESET_COLOR" "$log_file"
	else
		printf "%s[OK]%s No failed commands.\n" "$OK_COLOR" "$RESET_COLOR"
		printf "%s[INFO]%s Full install log: %s\n" "$INFO_COLOR" "$RESET_COLOR" "$log_file"
	fi
}

if [ "$(uname -s)" != "Darwin" ]; then
	warn "This script is intended for macOS; continuing anyway."
fi

log "Detailed command output is written to: $log_file"

log "Checking Xcode Command Line Tools"
if xcode-select -p >/dev/null 2>&1; then
	skip "Xcode Command Line Tools already installed" "$(xcode-select -p 2>/dev/null)"
else
	run "xcode-select --install"
	warn "Finish the Xcode Command Line Tools installer prompt if macOS opened one."
fi

log "Installing Homebrew"
setup_brew_path
if command_exists brew; then
	skip "Homebrew already installed" "$(brew --version 2>/dev/null | head -n 1)"
else
	run "/bin/bash -c \"\$(curl -fsSL https://raw.githubusercontent.com/Homebrew/install/HEAD/install.sh)\""
	setup_brew_path
fi

if command_exists brew; then
	log "Updating Homebrew"
	run "brew update"
	run "brew upgrade"

	log "Installing core packages"
	core_packages=(curl wget git unzip zip jq make cmake ninja pkg-config ca-certificates gnupg ripgrep fd fzf tree htop btop tmux zsh sqlite python pipx go openjdk@21 node kubectl helm gh azure-cli)
	install_brew_packages "Core" "${core_packages[@]}"

	log "Configuring pipx"
	case ":$PATH:" in
		*":$HOME/.local/bin:"*) skip "pipx path already configured" "$PATH" ;;
		*) run "pipx ensurepath" ;;
	esac

	log "Installing global npm tools"
	if command_exists npm; then
		install_npm_packages npm yarn pnpm typescript ts-node eslint prettier
	else
		warn "npm is not available yet; skipping global npm tools."
	fi

	log "Installing Rust"
	if command_exists rustc && command_exists cargo; then
		skip "Rust already installed" "$(rustc --version 2>/dev/null), $(cargo --version 2>/dev/null)"
	else
		run "curl https://sh.rustup.rs -sSf | sh -s -- -y"
	fi

	log "Installing Docker Desktop"
	if command_exists docker && docker compose version >/dev/null 2>&1; then
		skip "Docker and Docker Compose already installed" "$(docker --version 2>/dev/null), $(docker compose version 2>/dev/null)"
	else
		install_brew_casks "Docker" docker
		warn "Open Docker.app once after installation to finish Docker Desktop setup."
	fi

	log "Installing common Python packages"
	if command_exists python3; then
		install_python_packages virtualenv ipython notebook jupyterlab pandas numpy requests openai anthropic
	else
		warn "python3 is not available yet; skipping Python packages."
	fi

	log "Versions"
	run "git --version"
	run "node -v"
	run "npm -v"
	run "python3 --version"
	run "docker --version"
	run "kubectl version --client"
	run "helm version"
	run "gh --version"
	run "az version"
else
	warn "Homebrew is not available, so package installation was skipped."
fi

log "Done. Restart the terminal afterwards so PATH changes take effect."
print_summary
EOF

chmod +x install-dev-tools-macos.sh
./install-dev-tools-macos.sh
