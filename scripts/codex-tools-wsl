# ==============================================================================
# Copy-paste ready script for creating install-dev-tools-wsl.sh.
# Intended to be run inside WSL on a Windows install.
# Public Domain; 2026 Philipp Elhaus
# ==============================================================================

cat > install-dev-tools-wsl.sh <<'EOF'
#!/usr/bin/env bash

set +e

if [ -t 1 ]; then
	INFO_COLOR=$'\033[1;34m'
	RUN_COLOR=$'\033[1;36m'
	OK_COLOR=$'\033[1;32m'
	SKIP_COLOR=$'\033[1;90m'
	WARN_COLOR=$'\033[1;33m'
	SUMMARY_COLOR=$'\033[1;35m'
	RESET_COLOR=$'\033[0m'
else
	INFO_COLOR=""
	RUN_COLOR=""
	OK_COLOR=""
	SKIP_COLOR=""
	WARN_COLOR=""
	SUMMARY_COLOR=""
	RESET_COLOR=""
fi

success_count=0
skip_count=0
fail_count=0
skipped_items=()
failed_commands=()
log_file="${TMPDIR:-/tmp}/install-dev-tools-$(date +%Y%m%d-%H%M%S).log"
verbose="${INSTALL_DEV_TOOLS_VERBOSE:-0}"

: > "$log_file"

log() {
	printf "\n%s[INFO]%s %s\n" "$INFO_COLOR" "$RESET_COLOR" "$1"
}

skip() {
	local label="$1"
	local detail="${2:-}"
	skip_count=$((skip_count + 1))
	skipped_items+=("$label")
	printf "%s[SKIP]%s %s\n" "$SKIP_COLOR" "$RESET_COLOR" "$label"
	{
		printf "\n[SKIP] %s\n" "$label"
		printf "[TIME] %s\n" "$(date -Is)"
		if [ -n "$detail" ]; then
			printf "[DETAIL] %s\n" "$detail"
		fi
	} >> "$log_file"
}

run() {
	local status
	printf "\n%s[RUN]%s %s\n" "$RUN_COLOR" "$RESET_COLOR" "$*"
	{
		printf "\n[RUN] %s\n" "$*"
		printf "[TIME] %s\n" "$(date -Is)"
	} >> "$log_file"
	if [ "$verbose" = "1" ]; then
		bash -c "$*" 2>&1 | tee -a "$log_file"
		status=${PIPESTATUS[0]}
	else
		bash -c "$*" >> "$log_file" 2>&1
		status=$?
	fi
	if [ "$status" -eq 0 ]; then
		success_count=$((success_count + 1))
		printf "%s[OK]%s %s\n" "$OK_COLOR" "$RESET_COLOR" "$*"
	else
		fail_count=$((fail_count + 1))
		failed_commands+=("$*")
		printf "%s[WARN]%s Failed with exit code %s, continuing: %s\n" "$WARN_COLOR" "$RESET_COLOR" "$status" "$*"
	fi
}

command_exists() {
	command -v "$1" >/dev/null 2>&1
}

apt_installed() {
	dpkg-query -W -f='${Status}' "$1" 2>/dev/null | grep -q "install ok installed"
}

install_apt_packages() {
	local label="$1"
	local package
	local -a missing=()
	local -a installed=()
	shift
	for package in "$@"; do
		if apt_installed "$package"; then
			installed+=("$package")
		else
			missing+=("$package")
		fi
	done
	if [ "${#installed[@]}" -gt 0 ]; then
		skip "$label apt packages already installed: ${#installed[@]}" "${installed[*]}"
	fi
	if [ "${#missing[@]}" -gt 0 ]; then
		run "sudo apt install -y ${missing[*]}"
	fi
}

npm_package_installed() {
	npm list -g --depth=0 "$1" >/dev/null 2>&1
}

install_npm_packages() {
	local package
	local -a missing=()
	local -a installed=()
	for package in "$@"; do
		if npm_package_installed "$package"; then
			installed+=("$package")
		else
			missing+=("$package")
		fi
	done
	if [ "${#installed[@]}" -gt 0 ]; then
		skip "Global npm packages already installed: ${#installed[@]}" "${installed[*]}"
	fi
	if [ "${#missing[@]}" -gt 0 ]; then
		run "sudo npm install -g ${missing[*]}"
	fi
}

python_package_installed() {
	python3 -m pip show "$1" >/dev/null 2>&1
}

install_python_packages() {
	local package
	local -a missing=()
	local -a installed=()
	for package in "$@"; do
		if python_package_installed "$package"; then
			installed+=("$package")
		else
			missing+=("$package")
		fi
	done
	if [ "${#installed[@]}" -gt 0 ]; then
		skip "Python packages already installed: ${#installed[@]}" "${installed[*]}"
	fi
	if [ "${#missing[@]}" -gt 0 ]; then
		run "python3 -m pip install --user --break-system-packages ${missing[*]}"
	fi
}

print_summary() {
	printf "\n%s[SUMMARY]%s %s succeeded, %s skipped/already done, %s failed\n" "$SUMMARY_COLOR" "$RESET_COLOR" "$success_count" "$skip_count" "$fail_count"
	if [ "$skip_count" -gt 0 ]; then
		printf "%s[SKIP]%s Skipped/already done:\n" "$SKIP_COLOR" "$RESET_COLOR"
		for item in "${skipped_items[@]}"; do
			printf "  - %s\n" "$item"
		done
	fi
	if [ "$fail_count" -gt 0 ]; then
		printf "%s[WARN]%s Failed commands:\n" "$WARN_COLOR" "$RESET_COLOR"
		for command in "${failed_commands[@]}"; do
			printf "  - %s\n" "$command"
		done
		printf "%s[INFO]%s Full install log: %s\n" "$INFO_COLOR" "$RESET_COLOR" "$log_file"
	else
		printf "%s[OK]%s No failed commands.\n" "$OK_COLOR" "$RESET_COLOR"
		printf "%s[INFO]%s Full install log: %s\n" "$INFO_COLOR" "$RESET_COLOR" "$log_file"
	fi
}

log "Detailed command output is written to: $log_file"

log "Updating apt"
run "sudo apt update"
run "sudo apt upgrade -y"

log "Installing core packages"
core_packages=(build-essential curl wget git unzip zip tar jq make cmake ninja-build pkg-config software-properties-common apt-transport-https ca-certificates gnupg lsb-release ripgrep fd-find fzf tree xclip htop btop net-tools dnsutils iputils-ping tmux zsh sqlite3 python3 python3-pip python3-venv pipx golang-go openjdk-21-jdk)
install_apt_packages "Core" "${core_packages[@]}"

log "Configuring pipx"
case ":$PATH:" in
	*":$HOME/.local/bin:"*) skip "pipx path already configured" "$PATH" ;;
	*) run "pipx ensurepath" ;;
esac

log "Installing Node.js LTS"
if command_exists node && command_exists npm; then
	skip "Node.js and npm already installed" "$(node -v 2>/dev/null), npm $(npm -v 2>/dev/null)"
else
	run "curl -fsSL https://deb.nodesource.com/setup_lts.x | sudo -E bash -"
	install_apt_packages "Node.js" nodejs
fi

log "Installing global npm tools"
install_npm_packages npm yarn pnpm typescript ts-node eslint prettier

log "Installing Rust"
if command_exists rustc && command_exists cargo; then
	skip "Rust already installed" "$(rustc --version 2>/dev/null), $(cargo --version 2>/dev/null)"
else
	run "curl https://sh.rustup.rs -sSf | sh -s -- -y"
fi

log "Installing Docker"
if command_exists docker && docker compose version >/dev/null 2>&1; then
	skip "Docker and Docker Compose already installed" "$(docker --version 2>/dev/null), $(docker compose version 2>/dev/null)"
else
	if [ -f /usr/share/keyrings/docker.gpg ]; then
		skip "Docker apt key already exists" "/usr/share/keyrings/docker.gpg"
	else
		run "curl -fsSL https://download.docker.com/linux/ubuntu/gpg | sudo gpg --dearmor -o /usr/share/keyrings/docker.gpg"
	fi
	if [ -f /etc/apt/sources.list.d/docker.list ]; then
		skip "Docker apt source already exists" "/etc/apt/sources.list.d/docker.list"
	else
		run "echo \"deb [arch=\$(dpkg --print-architecture) signed-by=/usr/share/keyrings/docker.gpg] https://download.docker.com/linux/ubuntu \$(lsb_release -cs) stable\" | sudo tee /etc/apt/sources.list.d/docker.list > /dev/null"
	fi
	run "sudo apt update"
	docker_packages=(docker-ce docker-ce-cli containerd.io docker-buildx-plugin docker-compose-plugin)
	install_apt_packages "Docker" "${docker_packages[@]}"
fi
if groups "$USER" | grep -qw docker; then
	skip "User already in docker group" "$USER"
else
	run "sudo usermod -aG docker \$USER"
fi

log "Installing kubectl"
if command_exists kubectl; then
	skip "kubectl already installed" "$(kubectl version --client 2>/dev/null | head -n 1)"
else
	run "curl -LO \"https://dl.k8s.io/release/\$(curl -L -s https://dl.k8s.io/release/stable.txt)/bin/linux/amd64/kubectl\""
	run "sudo install -o root -g root -m 0755 kubectl /usr/local/bin/kubectl"
	run "rm -f kubectl"
fi

log "Installing Helm"
if command_exists helm; then
	skip "Helm already installed" "$(helm version 2>/dev/null)"
else
	run "curl https://raw.githubusercontent.com/helm/helm/main/scripts/get-helm-3 | bash"
fi

log "Installing GitHub CLI"
if command_exists gh; then
	skip "GitHub CLI already installed" "$(gh --version 2>/dev/null | head -n 1)"
else
	run "sudo mkdir -p -m 755 /etc/apt/keyrings"
	if [ -f /etc/apt/keyrings/githubcli-archive-keyring.gpg ]; then
		skip "GitHub CLI apt key already exists" "/etc/apt/keyrings/githubcli-archive-keyring.gpg"
	else
		run "wget -qO- https://cli.github.com/packages/githubcli-archive-keyring.gpg | sudo tee /etc/apt/keyrings/githubcli-archive-keyring.gpg > /dev/null"
	fi
	run "sudo chmod go+r /etc/apt/keyrings/githubcli-archive-keyring.gpg"
	if [ -f /etc/apt/sources.list.d/github-cli.list ]; then
		skip "GitHub CLI apt source already exists" "/etc/apt/sources.list.d/github-cli.list"
	else
		run "echo \"deb [arch=\$(dpkg --print-architecture) signed-by=/etc/apt/keyrings/githubcli-archive-keyring.gpg] https://cli.github.com/packages stable main\" | sudo tee /etc/apt/sources.list.d/github-cli.list > /dev/null"
	fi
	run "sudo apt update"
	install_apt_packages "GitHub CLI" gh
fi

log "Installing Azure CLI"
if command_exists az; then
	skip "Azure CLI already installed" "$(az version 2>/dev/null | head -n 1)"
else
	run "curl -sL https://aka.ms/InstallAzureCLIDeb | sudo bash"
fi

log "Installing common Python packages"
install_python_packages virtualenv ipython notebook jupyterlab pandas numpy requests openai anthropic

log "Versions"
run "git --version"
run "node -v"
run "npm -v"
run "python3 --version"
run "docker --version"
run "kubectl version --client"
run "helm version"
run "gh --version"
run "az version"

log "Done. Restart WSL afterwards with: wsl --shutdown"
print_summary
EOF

chmod +x install-dev-tools-wsl.sh
./install-dev-tools-wsl.sh
